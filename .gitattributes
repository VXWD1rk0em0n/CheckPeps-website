# Normalise to LF in the repo regardless of the checkout platform.
* text=auto eol=lf

# Host config files are parsed by the deploy target, not by a browser. CRLF in
# these has bitten real deploys, so pin them explicitly.
_headers      text eol=lf
robots.txt    text eol=lf
*.webmanifest text eol=lf

# Binary — never touch line endings, never try to diff as text.
*.png binary
